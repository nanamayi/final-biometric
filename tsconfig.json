{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "allowJs": true,
    "resolveJsonModule": true,

    "types": ["node", "web-bluetooth", "vite/client"],  // ← added vite/client

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },

  "include": ["src"]
}